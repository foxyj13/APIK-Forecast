# ==============================================================
# Аргументы для запуска экспорта данных наблюдений и прогнозов 
# ==============================================================

# ВАЖНО! 
#   1. Пробелы между именем аргумента, знаком равно и значением аргумента НЕДОПУСТИМЫ.
#   2. Комментарии могут быть только на отдельной строке, и начинаются со знака решетки (#)

# Экспорт возможен только для ранее рассчитанных прогнозов 
# (должны быть в наличии соответствующие .pkl файлы)
# Все настройки работы производятся в файле, указанном ниже.

# Путь и имя конфигурационного файла, необходимого для экспорта данных
#   Путь задается относительно корневой директории проекта
FARGS=./config/args_export.ini
